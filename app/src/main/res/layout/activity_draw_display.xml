<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_display"
    tools:context=".DrawDisplay">

    <!-- 何人目か -->
    <TextView
        android:id="@+id/playerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="1人目"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/homeButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/homeButton" />

    <!-- 何周目か -->
    <TextView
        android:id="@+id/roundText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="1周目"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/homeButton"
        app:layout_constraintEnd_toStartOf="@id/homeButton"
        app:layout_constraintTop_toTopOf="@id/homeButton" />

    <!-- ホームボタン -->
    <Button
        android:id="@+id/homeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:text="ホーム"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 上部ツールバー（戻る・進む・全消去・完了） -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/homeButton">

        <!-- 1. 戻るボタン（左矢印） -->

        <!-- 2. 進むボタン（右矢印） -->

        <ImageButton
            android:id="@+id/Back"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="戻る"
            android:scaleType="fitCenter"
            android:src="@drawable/back" />

        <ImageButton
            android:id="@+id/move_on"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="進む"
            android:scaleType="fitCenter"
            android:src="@drawable/moveon" />

        <!-- 3. 全消去ボタン（ゴミ箱） -->
        <ImageButton
            android:id="@+id/erase"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="全消去"
            android:scaleType="fitCenter"
            android:src="@drawable/erase" />

        <!-- 4. 完了ボタン（緑チェック） -->
        <ImageButton
            android:id="@+id/complete"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="完了"
            android:scaleType="fitCenter"
            android:src="@drawable/complete" />
    </LinearLayout>

    <!-- 描画エリア（お絵かき部分は白背景のまま維持） -->
    <com.example.helloandroid.DrawingView
        android:id="@+id/drawingView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/eraser"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topToolbar" />

    <!-- 9. 消しゴムボタン（ピンク） -->
    <ImageButton
        android:id="@+id/eraser"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="消しゴム"
        android:scaleType="centerCrop"
        android:src="@drawable/eracer"
        app:layout_constraintBottom_toTopOf="@id/colorToolbar"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 下部ペン色選択ボタン（黒・赤・青・黄） -->
    <LinearLayout
        android:id="@+id/colorToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:text="1人目"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 何週目か -->
    <TextView
        android:id="@+id/roundText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:text="1週目"
        android:textColor="#FAF6F6"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/homeButton"
        app:layout_constraintTop_toTopOf="parent" />
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 5. 黒ペン -->
        <ImageButton
            android:id="@+id/coller1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="黒"
            android:scaleType="centerCrop"
            android:src="@drawable/black" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 6. 赤ペン -->
        <ImageButton
            android:id="@+id/coller2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="赤"
            android:scaleType="centerCrop"
            android:src="@drawable/red" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 8. 青ペン -->
        <ImageButton
            android:id="@+id/coller4"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="青"
            android:scaleType="centerCrop"
            android:src="@drawable/blue" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 7. 黄ペン -->
        <ImageButton
            android:id="@+id/coller3"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="黄"
            android:scaleType="centerCrop"
            android:src="@drawable/yellow" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>