<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_felt_yellow"
    tools:context=".DrawDisplay">

    <!-- 1. 戻るボタン（左矢印） -->
    <ImageButton
        android:id="@+id/Back"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/btn_back"
        android:contentDescription="戻る"
        android:background="?android:attr/selectableItemBackground"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/move_on"
        app:layout_constraintHorizontal_bias="0.583"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.133" />

    <!-- 2. 進むボタン（右矢印：btn_move_on） -->
    <ImageButton
        android:id="@+id/move_on"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/btn_move_on"
        android:contentDescription="進む"
        android:background="?android:attr/selectableItemBackground"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.359"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.133" />

    <!-- 3. 全消去ボタン（ゴミ箱） -->
    <ImageButton
        android:id="@+id/erase"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/btn_erase"
        android:contentDescription="全消去"
        android:background="?android:attr/selectableItemBackground"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.678"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.133" />

    <!-- 4. 完了ボタン（緑チェック） -->
    <ImageButton
        android:id="@+id/complete"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/btn_complete"
        android:contentDescription="完了"
        android:background="?android:attr/selectableItemBackground"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.993"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.133" />

    <!-- 5. 黒ペン -->
    <ImageButton
        android:id="@+id/coller1"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/btn_pen_black"
        android:contentDescription="黒"
        android:background="?android:attr/selectableItemBackground"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.176"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.774" />

    <!-- 6. 赤ペン -->
    <ImageButton
        android:id="@+id/coller2"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/btn_pen_red"
        android:contentDescription="赤"
        android:background="?android:attr/selectableItemBackground"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.448"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.78" />

    <!-- 7. 黄ペン -->
    <ImageButton
        android:id="@+id/coller3"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/btn_pen_yellow"
        android:contentDescription="黄"
        android:background="?android:attr/selectableItemBackground"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.721"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.78" />

    <!-- 8. 青ペン -->
    <ImageButton
        android:id="@+id/coller4"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/btn_pen_blue"
        android:contentDescription="青"
        android:background="?android:attr/selectableItemBackground"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.993"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.78" />

    <!-- 9. 消しゴムボタン（ピンク） -->
    <ImageButton
        android:id="@+id/eraser"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/btn_eraser_pen"
        android:contentDescription="消しゴム"
        android:background="?android:attr/selectableItemBackground"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.122"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.701" />

    <!-- 描画エリア（お絵かき部分は白背景のまま維持） -->
    <com.example.helloandroid.DrawingView
        android:id="@+id/drawingView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/Back"
        app:layout_constraintBottom_toTopOf="@id/eraser"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

    <!-- 何人目か -->
    <TextView
        android:id="@+id/playerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1人目"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 何週目か -->
    <TextView
        android:id="@+id/roundText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1週目"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/homeButton"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp" />

    <!-- ホームボタン -->
    <Button
        android:id="@+id/homeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ホーム"
        android:textSize="14sp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>